<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Proposta Comercial — Presença Digital e Vendas | Vamos Viagens × Moca Mídias</title>
<meta name="description" content="Proposta comercial para Vamos Viagens: criação de site indexável no Google e nas IAs e gestão de tráfego pago com funil de vendas.">
<meta name="theme-color" content="#372261">
<meta name="robots" content="noindex, nofollow">
<meta property="og:type" content="website">
<meta property="og:locale" content="pt_BR">
<meta property="og:site_name" content="Moca Mídias">
<meta property="og:title" content="Proposta Comercial — Vamos Viagens | Moca Mídias">
<meta property="og:description" content="Site indexável e gestão de tráfego pago com funil de vendas para agências de viagem.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ===== TOKENS ===== */
:root{
--primary:#372261;--primary-light:#4A2D7A;--primary-dark:#2A1A4A;--primary-ultra-light:#F3EEF9;
--accent:#D4A843;--accent-hover:#B8922E;
--text-primary:#1A1A2E;--text-secondary:#5A5A72;--text-light:#8A8A9E;
--bg-white:#FFFFFF;--bg-alt:#F8F6FC;--border:#E8E0F0;
--shadow-sm:0 2px 8px rgba(55,34,97,.08);--shadow-md:0 4px 16px rgba(55,34,97,.12);--shadow-lg:0 8px 32px rgba(55,34,97,.16);
--radius-sm:8px;--radius-md:12px;--radius-lg:16px;--radius-pill:999px;
--font-heading:'Plus Jakarta Sans',sans-serif;--font-body:'Inter',sans-serif;--container-max:1140px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{font-family:var(--font-body);color:var(--text-primary);line-height:1.65;background:var(--bg-white);-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:var(--font-heading);font-weight:700;line-height:1.2;color:var(--primary)}
a{text-decoration:none}
.container{max-width:var(--container-max);margin:0 auto;padding:0 24px}
section{padding:80px 0}
.bg-alt{background:var(--bg-alt)}
.section-header{text-align:center;margin-bottom:52px}
.section-header h2{font-size:clamp(28px,4vw,36px);margin-bottom:16px}
.section-header p{font-size:17px;color:var(--text-secondary);max-width:660px;margin:0 auto}
.eyebrow{display:inline-block;background:var(--primary-ultra-light);color:var(--primary);padding:6px 16px;border-radius:var(--radius-pill);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;margin-bottom:16px}
.eyebrow-light{background:rgba(255,255,255,.1);color:var(--accent)}

/* ===== HEADER ===== */
header{background:var(--primary);padding:16px 0;position:sticky;top:0;z-index:100;box-shadow:var(--shadow-md)}
header .container{display:flex;justify-content:space-between;align-items:center;gap:16px}
.logo{font-family:var(--font-heading);font-size:21px;font-weight:800;color:#fff;white-space:nowrap}
.logo span{color:var(--accent)}
.nav-links{display:flex;gap:22px}
.nav-links a{color:rgba(255,255,255,.82);font-size:14px;font-weight:500;transition:color .3s}
.nav-links a:hover{color:var(--accent)}
.header-cta{background:var(--accent);color:var(--primary-dark);padding:11px 20px;border-radius:var(--radius-sm);font-weight:600;font-size:14px;transition:all .3s;white-space:nowrap}
.header-cta:hover{background:var(--accent-hover);transform:translateY(-2px)}

/* ===== HERO ===== */
.hero{background:linear-gradient(135deg,var(--primary) 0%,var(--primary-dark) 100%);color:#fff;padding:84px 0 68px;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 18% 45%,rgba(212,168,67,.15) 0%,transparent 52%)}
.hero .container{position:relative;z-index:1}
.hero-meta{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:22px}
.hero-meta span{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);padding:7px 15px;border-radius:var(--radius-pill);font-size:12.5px;font-weight:600}
.hero h1{color:#fff;font-size:clamp(29px,5vw,45px);margin-bottom:18px;max-width:760px}
.hero h1 em{color:var(--accent);font-style:normal}
.hero p{font-size:17px;color:rgba(255,255,255,.85);max-width:660px;margin-bottom:30px}
.hero-buttons{display:flex;gap:14px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:15px 28px;border-radius:var(--radius-sm);font-weight:600;font-size:15px;transition:all .3s;cursor:pointer;border:none;font-family:var(--font-body)}
.btn-primary{background:var(--accent);color:var(--primary-dark)}
.btn-primary:hover{background:var(--accent-hover);transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.btn-secondary{background:rgba(255,255,255,.1);color:#fff;border:2px solid rgba(255,255,255,.3)}
.btn-secondary:hover{background:rgba(255,255,255,.2);border-color:#fff}
.btn-block{width:100%}

/* ===== INFO BAR ===== */
.info-bar{background:var(--accent);color:var(--primary-dark);padding:14px 0}
.info-bar .container{display:flex;justify-content:center;gap:36px;flex-wrap:wrap;font-weight:700;font-size:13.5px;text-align:center}

/* ===== CONTEXTO ===== */
.context-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:22px;margin-top:36px}
.context-card{background:var(--bg-white);border:1px solid var(--border);border-radius:var(--radius-md);padding:26px;box-shadow:var(--shadow-sm);transition:all .3s}
.context-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
.context-card .ic{font-size:27px;margin-bottom:12px}
.context-card h3{font-size:17px;margin-bottom:9px}
.context-card p{font-size:14.5px;color:var(--text-secondary)}

/* ===== AUTORIDADE ===== */
.authority{display:flex;gap:18px;align-items:flex-start;background:var(--bg-white);border:1px solid var(--border);border-radius:var(--radius-md);padding:28px;box-shadow:var(--shadow-sm)}
.authority-badge{flex-shrink:0;width:46px;height:46px;border-radius:var(--radius-md);background:var(--primary);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:22px}
.authority h3{font-size:18px;margin-bottom:8px}
.authority p{font-size:14.5px;color:var(--text-secondary)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px;margin-top:26px}
.stat{background:var(--primary-ultra-light);border:1px solid var(--border);border-radius:var(--radius-md);padding:20px;text-align:center}
.stat b{display:block;font-family:var(--font-heading);font-size:26px;font-weight:800;color:var(--primary)}
.stat span{font-size:12.5px;color:var(--text-secondary)}

/* ===== ABAS DE SERVIÇOS ===== */
.tabs-nav{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:34px}
.tab-btn{background:var(--bg-white);border:2px solid var(--border);color:var(--text-secondary);padding:13px 22px;border-radius:var(--radius-pill);font-family:var(--font-body);font-size:14px;font-weight:600;cursor:pointer;transition:all .3s;display:inline-flex;align-items:center;gap:8px}
.tab-btn:hover{border-color:var(--accent);color:var(--primary)}
.tab-btn.active{background:var(--primary);border-color:var(--primary);color:#fff}
.tab-btn.active .tab-price{color:var(--accent)}
.tab-price{font-size:12px;opacity:.85;font-weight:700}
.tab-panel{display:none;animation:fade .35s ease}
.tab-panel.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

.service-card{background:var(--bg-white);border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);overflow:hidden}
.service-head{background:linear-gradient(135deg,var(--primary),var(--primary-light));color:#fff;padding:32px}
.service-head .tagline{display:inline-block;background:rgba(212,168,67,.2);color:var(--accent);padding:5px 14px;border-radius:var(--radius-pill);font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px}
.service-head h3{color:#fff;font-size:clamp(21px,3.2vw,27px);margin-bottom:10px}
.service-head p{color:rgba(255,255,255,.85);font-size:15px;max-width:620px}
.service-facts{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}
.service-facts div{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:var(--radius-sm);padding:10px 16px;font-size:13px}
.service-facts b{color:var(--accent);display:block;font-size:16px;font-family:var(--font-heading)}
.service-body{padding:32px}
.block-title{font-size:16px;margin:0 0 16px;display:flex;align-items:center;gap:10px}
.block-title::before{content:'';width:4px;height:20px;background:var(--accent);border-radius:2px}
.service-body .block + .block{margin-top:34px}

.check-list{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:10px 24px}
.check-list li{position:relative;padding-left:26px;font-size:14.5px;color:var(--text-secondary);padding-top:4px;padding-bottom:4px}
.check-list li::before{content:'✓';position:absolute;left:0;top:4px;color:var(--accent);font-weight:800}
.check-list li strong{color:var(--text-primary)}

.step{display:grid;grid-template-columns:78px 1fr;background:var(--bg-alt);border:1px solid var(--border);border-radius:var(--radius-md);overflow:hidden;margin-bottom:12px}
.step-num{background:linear-gradient(160deg,var(--primary),var(--primary-light));color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:16px 8px}
.step-num b{font-family:var(--font-heading);font-size:23px;color:var(--accent)}
.step-num span{font-size:9.5px;text-transform:uppercase;letter-spacing:.09em;opacity:.85}
.step-body{padding:18px 22px;background:var(--bg-white)}
.step-body h4{font-size:15.5px;margin-bottom:6px}
.step-body p{font-size:13.8px;color:var(--text-secondary);margin-bottom:8px}
.tags{display:flex;flex-wrap:wrap;gap:7px}
.tag{background:var(--primary-ultra-light);border:1px solid var(--border);border-radius:var(--radius-pill);padding:4px 11px;font-size:11.5px;font-weight:500;color:var(--primary)}

.notice{border-left:4px solid var(--accent);background:var(--primary-ultra-light);border-radius:var(--radius-sm);padding:16px 20px;font-size:14px;color:var(--text-secondary);margin-top:22px}
.notice strong{color:var(--primary)}
.notice.warn{border-left-color:#C93B48;background:#FDF2F3}

.deliver-table{width:100%;border-collapse:collapse;font-size:14px;margin-top:6px}
.deliver-table th{background:var(--primary);color:#fff;text-align:left;padding:13px 16px;font-family:var(--font-heading);font-size:13px;font-weight:700}
.deliver-table td{padding:13px 16px;border-bottom:1px solid var(--border);color:var(--text-secondary);vertical-align:top}
.deliver-table tr:last-child td{border-bottom:none}
.deliver-table tbody tr:nth-child(even){background:var(--bg-alt)}
.deliver-table td strong{color:var(--text-primary)}
.table-wrap{overflow-x:auto;border-radius:var(--radius-md);border:1px solid var(--border)}

.service-foot{background:var(--bg-alt);border-top:1px solid var(--border);padding:26px 32px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.service-foot .val{font-family:var(--font-heading);font-size:clamp(24px,3.4vw,32px);font-weight:800;color:var(--primary)}
.service-foot .val small{display:block;font-size:13px;color:var(--text-secondary);font-weight:500;font-family:var(--font-body)}

/* ===== PACOTES ===== */
.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(285px,1fr));gap:26px;max-width:1020px;margin:0 auto}
.price-card{background:var(--bg-white);border:2px solid var(--border);border-radius:var(--radius-lg);padding:38px 30px;box-shadow:var(--shadow-sm);transition:all .3s;position:relative;display:flex;flex-direction:column}
.price-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.price-card.featured{border-color:var(--accent);box-shadow:var(--shadow-md)}
.price-card.featured::before{content:'Recomendado';position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--accent);color:var(--primary-dark);padding:5px 18px;border-radius:var(--radius-pill);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}
.price-card .label{font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--primary-light);margin-bottom:8px}
.price-card h3{font-size:19px;margin-bottom:16px}
.price{font-family:var(--font-heading);font-size:clamp(28px,3.8vw,36px);font-weight:800;color:var(--primary);line-height:1.1}
.price small{font-size:14px;color:var(--text-secondary);font-weight:500;font-family:var(--font-body)}
.price-old{font-size:14px;color:var(--text-light);text-decoration:line-through;margin-top:4px}
.price-card ul{list-style:none;margin:20px 0 24px;flex-grow:1}
.price-card ul li{padding:7px 0;font-size:14px;color:var(--text-secondary);position:relative;padding-left:25px}
.price-card ul li::before{content:'✓';position:absolute;left:0;color:var(--accent);font-weight:800}
.benchmark-note{margin:28px auto 0;text-align:center;font-size:13.5px;color:var(--text-light);background:var(--primary-ultra-light);border:1px solid var(--border);border-radius:var(--radius-md);padding:18px 24px;max-width:800px}
.benchmark-note strong{color:var(--primary)}

/* ===== CRONOGRAMA ===== */
.timeline{max-width:820px;margin:0 auto}
.tl-item{display:grid;grid-template-columns:104px 1fr;gap:0;margin-bottom:12px}
.tl-when{background:var(--primary);color:#fff;border-radius:var(--radius-md) 0 0 var(--radius-md);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:16px 10px}
.tl-when b{font-family:var(--font-heading);font-size:15px;color:var(--accent);text-align:center;line-height:1.25}
.tl-when span{font-size:10px;text-transform:uppercase;letter-spacing:.08em;opacity:.8}
.tl-body{background:var(--bg-white);border:1px solid var(--border);border-left:none;border-radius:0 var(--radius-md) var(--radius-md) 0;padding:18px 22px}
.tl-body h4{font-size:15.5px;margin-bottom:5px}
.tl-body p{font-size:13.8px;color:var(--text-secondary)}

/* ===== NÃO INCLUSO ===== */
.excl-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.excl-card{background:var(--bg-white);border:1px solid var(--border);border-left:4px solid #C93B48;border-radius:var(--radius-sm);padding:20px}
.excl-card h4{font-size:15px;margin-bottom:6px}
.excl-card p{font-size:13.8px;color:var(--text-secondary)}

/* ===== FAQ ===== */
.faq-list{max-width:800px;margin:0 auto}
.faq-item{background:var(--bg-white);border:1px solid var(--border);border-radius:var(--radius-md);margin-bottom:11px;overflow:hidden;box-shadow:var(--shadow-sm)}
.faq-question{padding:19px 24px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:14px;font-weight:600;font-size:15px;color:var(--primary);transition:background .3s}
.faq-question:hover{background:var(--primary-ultra-light)}
.faq-question::after{content:'+';font-size:22px;color:var(--accent);transition:transform .3s;flex-shrink:0}
.faq-item.active .faq-question::after{transform:rotate(45deg)}
.faq-answer{padding:0 24px;max-height:0;overflow:hidden;transition:all .35s;color:var(--text-secondary);font-size:14.3px}
.faq-item.active .faq-answer{padding:0 24px 21px;max-height:520px}

/* ===== CTA ===== */
.cta-section{background:linear-gradient(135deg,var(--primary) 0%,var(--primary-dark) 100%);color:#fff;text-align:center;padding:86px 0;position:relative;overflow:hidden}
.cta-section::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 78% 22%,rgba(212,168,67,.17),transparent 52%)}
.cta-section .container{position:relative;z-index:1}
.cta-section h2{color:#fff;font-size:clamp(25px,4vw,34px);margin-bottom:15px}
.cta-section p{color:rgba(255,255,255,.85);font-size:16px;max-width:580px;margin:0 auto 28px}
.validity-box{display:inline-block;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);padding:12px 24px;border-radius:var(--radius-sm);margin-bottom:28px;font-size:14px}
.validity-box strong{color:var(--accent)}

footer{background:var(--primary-dark);color:rgba(255,255,255,.7);text-align:center;padding:34px 0;font-size:13.3px}
footer p{margin-bottom:6px}
footer strong{color:var(--accent)}
footer a{color:rgba(255,255,255,.7)}
footer a:hover{color:var(--accent)}

/* ===== RESPONSIVO ===== */
@media(max-width:900px){.nav-links{display:none}}
@media(max-width:640px){
section{padding:54px 0}
.hero{padding:56px 0 48px}
.info-bar .container{gap:14px;font-size:12.5px}
.service-head,.service-body,.service-foot{padding:24px 20px}
.step{grid-template-columns:1fr}
.step-num{flex-direction:row;gap:8px;padding:11px}
.tl-item{grid-template-columns:1fr}
.tl-when{border-radius:var(--radius-md) var(--radius-md) 0 0;flex-direction:row;gap:8px;padding:11px}
.tl-body{border-left:1px solid var(--border);border-radius:0 0 var(--radius-md) var(--radius-md)}
.hero-buttons .btn{width:100%}
.tabs-nav{flex-direction:column}
.tab-btn{width:100%;justify-content:space-between}
.price-card{padding:32px 22px}
.service-foot{flex-direction:column;align-items:stretch}
.service-foot .btn{width:100%}
}
@media print{
header,.header-cta,.hero-buttons,.btn,.tabs-nav{display:none!important}
.tab-panel{display:block!important;margin-bottom:32px}
.faq-answer{max-height:none!important;padding:0 24px 21px!important}
section{padding:28px 0;page-break-inside:avoid}
.hero,.cta-section{background:var(--primary)!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>
</head>
